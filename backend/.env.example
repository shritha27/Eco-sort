# EcoSort Backend Environment Variables Example

# Application Environment: 'development' or 'production'
APP_ENV=development

# Database Connection URL (PostgreSQL in production; Neon/Supabase recommended)
# e.g., postgresql://username:password@ep-sample-123.region.neon.tech/ecosort?sslmode=require
# If empty in development, falls back to a local SQLite database for offline prototyping.
DATABASE_URL=

# Frontend Origin for CORS (e.g. http://localhost:5173 for local, https://your-frontend.vercel.app for production)
FRONTEND_ORIGIN=http://localhost:5173

# Admin Security Key / Token for protected administrative endpoints
ADMIN_SECRET_KEY=dev-admin-secret-change-in-production

# Allow demo/evaluation mode for Admin & Partner dashboards without strict tokens in dev
ALLOW_DEMO_ADMIN=True

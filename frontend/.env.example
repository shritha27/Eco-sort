# EcoSort Frontend Environment Variables Example

# Backend API base URL
# Local development:
VITE_API_BASE_URL=http://localhost:8000

# Production:
# VITE_API_BASE_URL=https://ecosort-backend.vercel.app

# Frontend application public URL (used for generating valid QR codes)
VITE_APP_URL=http://localhost:5173
# Production:
# VITE_APP_URL=https://ecosort-frontend.vercel.app
